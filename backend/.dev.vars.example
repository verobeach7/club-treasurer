# Copy to .dev.vars for local development (gitignored). Values here override wrangler.jsonc vars.
# Production secrets: `npx wrangler secret put <NAME>`.

# Frontend dev origin allowed by CORS locally.
WEB_ORIGIN=http://localhost:5174

# Only needed when RECEIPT_MODEL is switched to an `openai/...` model.
# OPENAI_API_KEY=
